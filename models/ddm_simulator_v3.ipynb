    "# Simulate complete experiment\n",
    "\n",
    "def simulate_full_dataset(\n",
    "    model=\"exponential\",\n",
    "    n_participants=24,\n",
    "    coherences=(0.03, 0.11, 0.29, 0.55, 0.73),\n",
    "    cues=(\"speed\", \"accuracy\"),\n",
    "    deadline_conditions=(\"deadline\", \"no_deadline\"),\n",
    "    n_trials_per_cell=50,\n",
    "    dt=0.002,\n",
    "    deadline_time=1.35,\n",
    "    max_time=3.50,\n",
    "    noise_sd=0.1,\n",
    "    seed=42,\n",
    "):\n",
    "    \"\"\"\n",
    "    Simulate a complete repeated-measures experiment.\n",
    "\n",
    "    Hierarchy\n",
    "    ---------\n",
    "    Participant\n",
    "        ├── participant parameters\n",
    "        │\n",
    "        ├── speed\n",
    "        │      ├── deadline\n",
    "        │      └── no deadline\n",
    "        │\n",
    "        └── accuracy\n",
    "               ├── deadline\n",
    "               └── no deadline\n",
    "    \"\"\"\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "\n",
    "    rows = []\n",
    "    true_params = []\n",
    "\n",
    "    # Loop over participants\n",
    "\n",
    "    for pp in range(1, n_participants + 1):\n",
    "\n",
    "        # Sample participant-level latent parameters ONCE\n",
    "        participant_params = sample_participant_priors(rng)\n",
    "\n",
    "        # Loop over experimental conditions\n",
    "\n",
    "        for cue in cues:\n",
    "\n",
    "            cue_int = 0 if cue == \"speed\" else 1\n",
    "\n",
    "            for deadline_cond in deadline_conditions:\n",
    "\n",
    "                deadline_int = (\n",
    "                    1 if deadline_cond == \"deadline\"\n",
    "                    else 0\n",
    "                )\n",
    "\n",
    "                params = apply_condition_effects(\n",
    "                    participant_params=participant_params,\n",
    "                    rng=rng,\n",
    "                    model=model,\n",
    "                    cue=cue_int,\n",
    "                    has_deadline=deadline_int,\n",
    "                )\n",
    "\n",
    "                deadline = (\n",
    "                    deadline_time\n",
    "                    if deadline_int\n",
    "                    else None\n",
    "                )\n",
    "\n",
    "                (\n",
    "                    rts,\n",
    "                    choices,\n",
    "                    coherences_used,\n",
    "                    difficulty_idx,\n",
    "                ) = simulate_cell(\n",
    "                    params=params,\n",
    "                    model=model,\n",
    "                    coherences=coherences,\n",
    "                    n_trials_per_diff=n_trials_per_cell,\n",
    "                    dt=dt,\n",
    "                    max_time=max_time,\n",
    "                    deadline_time=deadline,\n",
    "                    noise_sd=noise_sd,\n",
    "                    rng=rng,\n",
    "                )\n",
    "\n",
    "\n",
    "                for rt, choice, coherence, difficulty in zip(\n",
    "                    rts,\n",
    "                    choices,\n",
    "                    coherences_used,\n",
    "                    difficulty_idx,\n",
    "                ):\n",
    "\n",
    "                    rows.append(\n",
    "                        {\n",
    "                            \"pp\": pp,\n",
    "                            \"cue\": cue,\n",
    "                            \"deadline\": deadline_cond,\n",
    "                            \"coherence\": coherence,\n",
    "                            \"difficulty\": difficulty,\n",
    "                            \"rt\": rt,\n",
    "                            \"acc\": (\n",
    "                                np.nan\n",
    "                                if choice == -1\n",
    "                                else int(choice == 1)\n",
    "                            ),\n",
    "                        }\n",
    "                    )\n",
    "\n",
    "                true_params.append(\n",
    "                    {\n",
    "                        \"pp\": pp,\n",
    "                        \"cue\": cue,\n",
    "                        \"deadline\": deadline_cond,\n",
    "                        **params,\n",
    "                    }\n",
    "                )\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(rows),\n",
    "        pd.DataFrame(true_params),\n",
    "    )"
   ]
