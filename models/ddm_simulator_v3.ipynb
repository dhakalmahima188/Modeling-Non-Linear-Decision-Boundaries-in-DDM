    "def simulate_ddm_batch(\n",
    "    v, a, t0, z, sv, boundary, dt, n_trials, deadline_step, noise_sd, rng,\n",
    "):\n",
    "    if sv > 0:\n",
    "        v_trial = rng.normal(v, sv, size=n_trials)\n",
    "    else:\n",
    "        v_trial = np.full(n_trials, v)\n",
    "\n",
    "    x = np.full(n_trials, (z - 0.5) * 2 * a, dtype=float)\n",
    "\n",
    "    rts = np.full(n_trials, np.nan)\n",
    "    choices = np.full(n_trials, -1, dtype=int)\n",
    "    active = np.ones(n_trials, dtype=bool)\n",
    "\n",
    "    max_steps = len(boundary)\n",
    "    if deadline_step is not None:\n",
    "        max_steps = min(max_steps, deadline_step)\n",
    "\n",
    "    # Draw all noise up front (one RNG call instead of up to max_steps calls)\n",
    "    noise = rng.standard_normal((max_steps, n_trials))\n",
    "    step_size = noise_sd * np.sqrt(dt)\n",
    "\n",
    "    for step in range(max_steps):\n",
    "        if not active.any():\n",
    "            break\n",
    "\n",
    "        b = boundary[step]\n",
    "\n",
    "        upper_hit = active & (x >= b)\n",
    "        lower_hit = active & (x <= -b)\n",
    "\n",
    "        rts[upper_hit] = t0 + step * dt\n",
    "        choices[upper_hit] = 1\n",
    "\n",
    "        rts[lower_hit] = t0 + step * dt\n",
    "        choices[lower_hit] = 0\n",
    "\n",
    "        active &= ~(upper_hit | lower_hit)\n",
    "\n",
    "        if active.any():\n",
    "            x[active] += v_trial[active] * dt + step_size * noise[step, active]\n",
    "\n",
    "    return rts, choices"
   ]
