    "\n",
    "# Simulate one experimental condition\n",
    "\n",
    "def simulate_cell(\n",
    "    params,\n",
    "    model,\n",
    "    coherences,\n",
    "    n_trials_per_diff,\n",
    "    dt,\n",
    "    max_time,\n",
    "    deadline_time=None,\n",
    "    z=0.5,\n",
    "    noise_sd=0.1,\n",
    "    rng=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Simulate one participant under one experimental condition.\n",
    "\n",
    "    The boundary is shared across all coherence levels.\n",
    "    Only the drift rate changes with coherence.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    params : dict\n",
    "        Output of apply_condition_effects().\n",
    "\n",
    "    model : str\n",
    "        Boundary model.\n",
    "\n",
    "    coherences : iterable\n",
    "        Stimulus coherence values.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    rts\n",
    "    choices\n",
    "    coherence_values\n",
    "    difficulty_indices\n",
    "    \"\"\"\n",
    "\n",
    "    if rng is None:\n",
    "        rng = np.random.default_rng()\n",
    "\n",
    "\n",
    "    # Time axis\n",
    "\n",
    "    time_axis = np.arange(int(max_time / dt)) * dt\n",
    "\n",
    "    boundary_fn = BOUNDARY_FNS[model]\n",
    "\n",
    "    shape_kwargs = {\n",
    "        name: params[name]\n",
    "        for name in SHAPE_PRIOR_RANGES[model]\n",
    "    }\n",
    "\n",
    "    boundary = boundary_fn(\n",
    "        time_axis,\n",
    "        a=params[\"a\"],\n",
    "        **shape_kwargs,\n",
    "    )\n",
    "\n",
    "    deadline_step = None\n",
    "\n",
    "    if deadline_time is not None:\n",
    "        deadline_step = int(deadline_time / dt)\n",
    "\n",
    "\n",
    "    # Simulate every coherence level\n",
    "    all_rts = []\n",
    "    all_choices = []\n",
    "    all_coherences = []\n",
    "    all_difficulties = []\n",
    "\n",
    "    for difficulty_idx, coherence in enumerate(coherences, start=1):\n",
    "\n",
    "        drift = params[\"v_scale\"] * coherence\n",
    "\n",
    "        rts, choices = simulate_ddm_batch(\n",
    "            v=drift,\n",
    "            a=params[\"a\"],\n",
    "            t0=params[\"t0\"],\n",
    "            z=z,\n",
    "            sv=params[\"sv\"],\n",
    "            boundary=boundary,\n",
    "            dt=dt,\n",
    "            n_trials=n_trials_per_diff,\n",
    "            deadline_step=deadline_step,\n",
    "            noise_sd=noise_sd,\n",
    "            rng=rng,\n",
    "        )\n",
    "\n",
    "        all_rts.append(rts)\n",
    "        all_choices.append(choices)\n",
    "\n",
    "        all_coherences.append(\n",
    "            np.full(n_trials_per_diff, coherence)\n",
    "        )\n",
    "\n",
    "        all_difficulties.append(\n",
    "            np.full(\n",
    "                n_trials_per_diff,\n",
    "                difficulty_idx,\n",
    "                dtype=int,\n",
    "            )\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        np.concatenate(all_rts),\n",
    "        np.concatenate(all_choices),\n",
    "        np.concatenate(all_coherences),\n",
    "        np.concatenate(all_difficulties),\n",
    "    )"
   ]
