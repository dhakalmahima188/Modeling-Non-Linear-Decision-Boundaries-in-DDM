    "import tensorflow as tf # Import tensorflow for tf.stack\n",
    "import keras\n",
    "\n",
    "@keras.saving.register_keras_serializable()\n",
    "def stack_trials_for_deepset(data, **kwargs):\n",
    "    # If the required keys are not present, return data as is.\n",
    "    # This handles cases where data is already processed or in inverse mode.\n",
    "    if 'rt' not in data or 'choice' not in data or 'coherence' not in data:\n",
    "        return data\n",
    "\n",
    "    # Stack rt, choice, and coherence along a new axis to create a 2D array\n",
    "    # Each row will be a trial, and columns will be its features (rt, choice, coherence)\n",
    "    stacked_data = tf.stack([data['rt'], data['choice'], data['coherence']], axis=-1)\n",
    "\n",
    "    # Create a new dictionary from the input data, keeping all original keys\n",
    "    # and adding 'summary_variables'. Explicitly remove the original\n",
    "    # 'rt', 'choice', 'coherence' as they are now combined.\n",
    "    output_data = {k: v for k, v in data.items() if k not in ['rt', 'choice', 'coherence']}\n",
    "    output_data['summary_variables'] = stacked_data\n",
    "    return output_data\n",
    "\n",
    "adapter = (\n",
    "    bf.adapters.Adapter()\n",
    "    .to_array()\n",
    "    .convert_dtype(\"float64\", \"float32\")\n",
    "    # design variables known as conditions (no inference)\n",
    "    .concatenate([\"cue\", \"has_deadline\"], into=\"inference_conditions\")\n",
    "    # target parameters to be estimated (only the 4 core parameters for inference network)\n",
    "    .concatenate([\"v_scale\", \"t0\", \"a_base\", \"sv\"], into=\"inference_variables\")\n",
    "    # Use add_transform to stack rt, choice, coherence and name the output 'summary_variables'\n",
    "    .add_transform(stack_trials_for_deepset)\n",
    "    # Drop 'difficulty' and other parameters not needed for inference/summary networks\n",
    "    .drop([\"difficulty\", \"model_idx\", \"k\", \"lam\", \"k_sig\", \"t_mid\"])\n",
    "    .keep([\"inference_conditions\", \"inference_variables\", \"summary_variables\"])\n",
    ")"
   ]
