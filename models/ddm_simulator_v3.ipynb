    "\n",
    "# Participant-level priors\n",
    "\n",
    "\n",
    "def sample_participant_priors(rng):\n",
    "    \"\"\"\n",
    "    Sample participant-specific latent parameters.\n",
    "\n",
    "    These are assumed to remain constant across all experimental\n",
    "    conditions for a participant.\n",
    "    \"\"\"\n",
    "\n",
    "    return {\n",
    "        \"v_scale\": rng.uniform(0.5, 2.0),\n",
    "        \"t0\": rng.uniform(0.15, 0.40),\n",
    "        \"sv\": rng.uniform(0.05, 0.30),\n",
    "        \"a_base\": rng.uniform(0.05, 0.20)\n",
    "    }\n",
    "\n",
    "\n",
    "# Condition-level effects\n",
    "\n",
    "def apply_condition_effects(\n",
    "    participant_params,\n",
    "    rng,\n",
    "    model=\"exponential\",\n",
    "    cue=None,\n",
    "    has_deadline=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Build the parameter vector for one experimental condition.\n",
    "\n",
    "    Hierarchy\n",
    "    ---------\n",
    "    Participant\n",
    "        ↓\n",
    "    Cue (changes boundary separation)\n",
    "        ↓\n",
    "    Deadline (changes collapse rate)\n",
    "        ↓\n",
    "    Trials\n",
    "    \"\"\"\n",
    "\n",
    "    params = participant_params.copy()\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Cue effect:\n",
    "    # Accuracy cue -> larger boundary\n",
    "    # Speed cue    -> smaller boundary\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    cue_shift = 0.0\n",
    "\n",
    "    if cue is not None:\n",
    "        cue_shift = {\n",
    "            0: -0.015,   # speed\n",
    "            1: +0.015,   # accuracy\n",
    "        }[cue]\n",
    "\n",
    "    params[\"a\"] = max(params.pop(\"a_base\") + cue_shift, 0.01)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Deadline effect:\n",
    "    # Deadline pushes collapse-rate toward the upper half\n",
    "    # of its prior range.\n",
    "    # --------------------------------------------------------\n",
    "\n",
    "    for name, (lo, hi) in SHAPE_PRIOR_RANGES[model].items():\n",
    "\n",
    "        if name in (\"k\", \"lam\", \"k_sig\") and has_deadline is not None:\n",
    "\n",
    "            midpoint = (lo + hi) / 2\n",
    "\n",
    "            if has_deadline:\n",
    "                params[name] = rng.uniform(midpoint, hi)\n",
    "            else:\n",
    "                params[name] = rng.uniform(lo, midpoint)\n",
    "\n",
    "        else:\n",
    "            params[name] = rng.uniform(lo, hi)\n",
    "\n",
    "    return params"
   ]
