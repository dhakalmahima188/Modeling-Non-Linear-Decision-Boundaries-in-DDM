    "def likelihood(\n",
    "    model_idx,\n",
    "    v_scale,\n",
    "    t0,\n",
    "    sv,\n",
    "    a_base,\n",
    "):\n",
    "    \"\"\"\n",
    "    Simulate one participant.\n",
    "\n",
    "    Returns all four\n",
    "        cue × deadline\n",
    "    conditions.\n",
    "    \"\"\"\n",
    "\n",
    "    rng = np.random.default_rng()\n",
    "\n",
    "    model = MODEL_NAMES[int(model_idx)]\n",
    "\n",
    "    participant = {\n",
    "        \"v_scale\": v_scale,\n",
    "        \"t0\": t0,\n",
    "        \"sv\": sv,\n",
    "        \"a_base\": a_base,\n",
    "    }\n",
    "\n",
    "    rt_all = []\n",
    "    choice_all = []\n",
    "    coherence_all = []\n",
    "\n",
    "    cue_all = []\n",
    "    deadline_all = []\n",
    "\n",
    "    for cue in CUES:\n",
    "\n",
    "        cue_int = 0 if cue == \"speed\" else 1\n",
    "\n",
    "        for deadline in DEADLINE_CONDITIONS:\n",
