    "    ax6.set_ylabel(\"Non-response rate\"); ax6.set_title(\"Missed-deadline rate\")\n",
    "\n",
    "    plt.suptitle(title or \"Simulated SAT dataset: cue & deadline effects\", fontsize=14, y=1.02)\n",
    "    plt.tight_layout(); plt.show()\n",
    "    \n",
    "\n",
    "\n",
    "\n"
